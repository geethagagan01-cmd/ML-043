)\\n\",","        \"X_poly = poly.fit_transform(x)\\n\",","        \"\\n\",","        \"#Train Model\\n\",","        \"model = LinearRegression()\\n\",","        \"model.fit(X_poly, y)\\n\",","        \"\\n\",","        \"#Predictions\\n\",","        \"y_pred = model.predict(X_poly)\\n\",","        \"\\n\",","        \"#Equations\\n\",","        \"print(\\\"Intercept:\\\", model.intercept_)\\n\",","        \"print(\\\"Coefficients:\\\", model.coef_)\\n\",","        \"\\n\",","        \"#MSE\\n\",","        \"mse = mean_squared_error(y,y_pred)\\n\",","        \"\\n\",","        \"print(\\\"Predicted values:\\\", y_pred)\\n\",","        \"print(\\\"Train MSE:\\\", mse)\\n\",","        \"\\n\",","        \"# Create smooth x values for the curve\\n\",","        \"x_curve = np.linspace(-2, 2, 100).reshape(-1, 1)\\n\",","        \"\\n\",","        \"# Create polynomial features for smooth x values\\n\",","        \"X_curve = poly.transform(x_curve)\\n\",","        \"\\n\",","        \"# Predict y values for the curve\\n\",","        \"y_curve = model.predict(X_curve)\\n\",","        \"\\n\",","        \"# Plot actual data points\\n\",","        \"plt.scatter(x, y, color=\\\"red\\\", label=\\\"Actual Data\\\")\\n\",","        \"\\n\",","        \"# Plot polynomial regression curve\\n\",","        \"plt.plot(x_curve, y_curve, color=\\\"blue\\\", label=\\\"Polynomial Regression\\\")\\n\",","        \"\\n\",","        \"# Labels and title\\n\",","        \"plt.xlabel(\\\"X\\\")\\n\",","        \"plt.ylabel(\\\"Y\\\")\\n\",","        \"plt.title(\\\"Polynomial Regression (Degree 2)\\\")\\n\",","        \"\\n\",","        \"# Show grid and legend\\n\",","        \"plt.grid(True)\\n\",","        \"plt.legend()\\n\",","        \"\\n\",","        \"# Display graph\\n\",","        \"plt.show()\"","      ]","    }","  ]","}"],colorizedLines:null,stylingDirectives:$R[337]={format:"compact",lineOffsets:$R[338]=[0,0,2,4,5,6,7,7,8,12,16,16,17,21,21,21,22,22,26,27,30,30,31,35,35,35,35,39